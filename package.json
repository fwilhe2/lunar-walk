{
  "name": "lunar-walk",
  "version": "1.0.0",
  "description": "A first-person planetary surface simulator",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "dist:linux": "electron-builder --linux AppImage --publish never",
    "dist:mac": "electron-builder --mac dmg --publish never",
    "dist:win": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "38.2.1",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.lunarwalk.app",
    "productName": "Lunar Walk",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "three.module.js",
      "jsm/**/*",
      "electron/**/*"
    ],
    "asar": true,
    "linux": {
      "target": ["AppImage"],
      "category": "Science"
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.education"
    },
    "win": {
      "target": ["nsis"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
