{
  "name": "lunar-walk",
  "version": "1.0.0",
  "description": "A first-person planetary surface simulator",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "tsc -p . && tsc -p tsconfig.kernel.json && tsc -p tests",
    "test": "vitest run",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder --publish never",
    "dist:linux": "vite build && electron-builder --linux AppImage --publish never",
    "dist:mac": "vite build && electron-builder --mac dmg --publish never",
    "dist:win": "vite build && electron-builder --win nsis --publish never",
    "perf": "PERF=1 vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/three": "0.160.0",
    "electron": "38.2.1",
    "electron-builder": "26.0.12",
    "puppeteer-core": "^25.12.0",
    "three": "0.160.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "build": {
    "appId": "com.lunarwalk.app",
    "productName": "Lunar Walk",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "asar": true,
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Science"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.education"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "type": "module",
  "packageManager": "bun@1.3.14"
}
